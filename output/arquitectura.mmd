graph LR
    subgraph "Docker Compose: lost_found_network"
        DB[("PostgreSQL<br/>db:5432<br/>lost_found_users + objects + claims")]
        AUDIT_DB[("PostgreSQL<br/>audit-db:5432<br/>audit_log_db")]
        RMQ[("RabbitMQ<br/>rabbitmq:5672")]
        CONSUL[("Consul<br/>consul:8500")]
        US["user-service<br/>:3002"]
        OS["object-service<br/>:3003"]
        CS["claim-service<br/>:3000"]
        AUDIT["audit-service<br/>:3001"]
        FE["frontend<br/>:5173"]
    end

    US -->|"Prisma<br/>DATABASE_URL"| DB
    OS -->|"Prisma<br/>DATABASE_URL"| DB
    CS -->|"Prisma<br/>DATABASE_URL"| DB
    AUDIT -->|"Prisma<br/>DATABASE_URL"| AUDIT_DB
    CS -->|"AMQP<br/>RABBITMQ_URL"| RMQ
    AUDIT -->|"AMQP<br/>RABBITMQ_URL"| RMQ
    CS -->|"HTTP API<br/>Service Discovery"| CONSUL
    FE -->|"REST API"| US
    FE -->|"REST API"| OS
