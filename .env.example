# ------------------------------
# Docker Compose (raiz)
# Copia este archivo como .env y ajusta según necesites:
#   cp .env.example .env
# ------------------------------

# Base de datos principal (compartida por user, object, claim)
DB_USER=admin
DB_PASSWORD=password123
DB_NAME=lost_found_uninorte
DB_PORT=5432

# Base de datos de auditoria
AUDIT_DB_USER=admin
AUDIT_DB_PASSWORD=password123
AUDIT_DB_NAME=audit_log_db
AUDIT_DB_PORT=5433

# Broker y descubrimiento
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CONSUL_HOST=consul
CONSUL_PORT=8500

# User service
USER_DATABASE_URL=postgresql://admin:password123@db:5432/lost_found_users?schema=public
USER_SERVICE_PORT=3002
USER_PUBLIC_PORT=3002

# Object service
OBJECT_DATABASE_URL=postgresql://admin:password123@db:5432/lost_found_objects?schema=public
OBJECT_SERVICE_PORT=3003
OBJECT_PUBLIC_PORT=3003

# Claim service
CLAIMS_DATABASE_URL=postgresql://admin:password123@db:5432/lost_found_claims?schema=public
CLAIMS_SERVICE_HOST=claim-service
CLAIMS_SERVICE_PORT=3000
CLAIMS_PUBLIC_PORT=3000
USER_SERVICE_URL=http://user-service:3002
OBJECT_SERVICE_URL=http://object-service:3003

# Audit service
AUDIT_DATABASE_URL=postgresql://admin:password123@audit-db:5432/audit_log_db?schema=public
AUDIT_SERVICE_PORT=3001
AUDIT_PUBLIC_PORT=3001

# Frontend
FRONTEND_PUBLIC_PORT=5173
CORS_ORIGIN=http://localhost:5173

# Entorno general
NODE_ENV=development
